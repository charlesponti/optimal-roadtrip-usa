  <wpt lat="-22.911111" lon="-43.205556">
    <name>Rio de Janeiro</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-23.550000" lon="-46.633333">
    <name>Sao Paulo</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-25.429722" lon="-49.271111">
    <name>Curitiba</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-27.592550" lon="-48.558163">
    <name>Florianopolis</name>
    <desc>verified 2026-09-26: city centre (Santa Catarina Island, bridge-connected)</desc>
  </wpt>
  <wpt lat="-29.378889" lon="-50.873889">
    <name>Gramado</name>
    <desc>verified 2026-09-26: town centre</desc>
  </wpt>
  <wpt lat="-34.955739" lon="-54.938115">
    <name>Punta del Este</name>
    <desc>verified 2026-09-26: city</desc>
