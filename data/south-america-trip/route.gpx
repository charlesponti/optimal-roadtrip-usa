  <wpt lat="10.998852" lon="-63.929052">
    <name>Isla Margarita</name>
    <desc>verified 2026-09-26: island; display keeps the page's hard-coded flight-polyline endpoint (legacy-polyline, on the island); not road-connected, drive point is the Conferry terminal at Puerto La Cruz (mainland car ferry to Margarita); the closing leg from Taganga arrives here by flight per override.json; legacy Google marker kept, 1502 m from wikipedia:en:Margarita_Island</desc>
  </wpt>
  <wpt lat="6.235794" lon="-62.852937">
    <name>Parque Nacional Canaima</name>
    <desc>verified 2026-09-26: national park, no address in query: display at Canaima village on Canaima Lagoon, the park's main visitor hub, which has no road access; drive point is Tomas de Heres Airport, Ciudad Bolivar, the usual air departure for Canaima (Troncal 10 through the park's Gran Sabana sector is the road-accessible part)</desc>
  </wpt>
  <wpt lat="-2.795168" lon="-40.515230">
    <name>Jericoacoara</name>
    <desc>verified 2026-09-26: Vila de Jericoacoara (dune village, 4x4-only access); drive point is Jijoca de Jericoacoara town, which is where Nominatim had put the stop</desc>
  </wpt>
  <wpt lat="-3.727500" lon="-38.527500">
    <name>Fortaleza</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-5.795000" lon="-35.208889">
    <name>Natal</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-12.974722" lon="-38.476667">
    <name>Salvador</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-16.592528" lon="-39.102806">
    <name>Trancoso</name>
    <desc>verified 2026-09-26: Trancoso village (Porto Seguro); Nominatim point was 10 km inland</desc>
  </wpt>
  <wpt lat="-19.928056" lon="-43.941944">
    <name>Belo Horizonte</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-22.746944" lon="-41.881944">
    <name>Buzios</name>
    <desc>verified 2026-09-26: Buzios town</desc>
