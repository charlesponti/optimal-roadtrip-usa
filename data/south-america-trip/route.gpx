  <wpt lat="-25.280000" lon="-57.634444">
    <name>Asuncion</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-34.603889" lon="-58.381389">
    <name>Buenos Aires</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-50.973232" lon="-72.782584">
    <name>Torres del Paine</name>
    <desc>verified 2026-09-26: national park, no address in query: display and drive at the Laguna Amarga ranger station, the park's main road entrance (Nominatim had an interior point 20 km west)</desc>
  </wpt>
  <wpt lat="-50.337778" lon="-72.260000">
    <name>El Calafate</name>
    <desc>verified 2026-09-26: town</desc>
  </wpt>
  <wpt lat="-41.133657" lon="-71.310332">
    <name>San Carlos de Bariloche</name>
    <desc>verified 2026-09-26: city centre (Centro Civico); enwiki/Wikidata point -41.15,-71.30 is rounded and lies 2 km south in the hills</desc>
  </wpt>
  <wpt lat="-34.637222" lon="-71.363056">
    <name>Santa Cruz</name>
    <desc>verified 2026-09-26: town in Colchagua</desc>
  </wpt>
  <wpt lat="-33.437500" lon="-70.650000">
    <name>Santiago</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-33.024444" lon="-71.551667">
    <name>Vina del Mar</name>
    <desc>verified 2026-09-26: city</desc>
  </wpt>
  <wpt lat="-22.910800" lon="-68.200100">
    <name>San Pedro de Atacama</name>
    <desc>verified 2026-09-26: town; Nominatim had the commune centroid 50 km southeast</desc>
  </wpt>
  <wpt lat="-16.495833" lon="-68.133333">
    <name>Nuestra Senora de La Paz</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-15.843333" lon="-70.023611">
    <name>Reserva Nacional Titicaca</name>
    <desc>verified 2026-09-26: national reserve on Lake Titicaca, no address in query: display and drive at Puno, the port for reserve boat trips (Uros islands); Nominatim had a point in the lake</desc>
  </wpt>
  <wpt lat="-16.398889" lon="-71.536944">
    <name>Arequipa</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-13.304167" lon="-72.116667">
    <name>Urubamba</name>
    <desc>verified 2026-09-26: town; Nominatim point was 18 km northwest</desc>
  </wpt>
  <wpt lat="-13.516900" lon="-71.978600">
    <name>Cusco</name>
    <desc>verified 2026-09-26: city centre</desc>
  </wpt>
  <wpt lat="-12.045833" lon="-77.030556">
    <name>Lima</name>
    <desc>verified 2026-09-26: city centre (Plaza Mayor); enwiki city point lies 1.7 km south</desc>
  </wpt>
  <wpt lat="-4.105556" lon="-81.047222">
    <name>Mancora</name>
    <desc>verified 2026-09-26: town; Nominatim point was 7 km southeast</desc>
  </wpt>
  <wpt lat="-0.220000" lon="-78.512500">
    <name>Quito</name>
    <desc>verified 2026-09-26: city centre; the page's flight polyline endpoint (-0.154687,-78.510119, 7 km north) is not the city; leg to Bogota (order 32) is a flight per override.json and the page's 'Flight between Quito &amp; Bogota' polyline</desc>
  </wpt>
  <wpt lat="4.598056" lon="-74.076111">
    <name>Bogota</name>
    <desc>verified 2026-09-26: city centre (Plaza de Bolivar); the page's flight polyline endpoint (4.604248,-74.156505) lies 8 km southwest</desc>
  </wpt>
  <wpt lat="10.426557" lon="-75.544167">
    <name>Cartagena</name>
    <desc>verified 2026-09-26: city (OSM city node in the walled old town); Wikidata point lies 2.1 km east of the old town</desc>
  </wpt>
  <wpt lat="11.240057" lon="-74.190282">
    <name>Santa Marta</name>
    <desc>verified 2026-09-26: city; display keeps the page's flight-polyline endpoint (legacy-polyline), 1.7 km east of the enwiki city point; legacy Google marker kept, 1649 m from wikipedia:en:Santa_Marta</desc>
  </wpt>
  <wpt lat="11.267479" lon="-74.190828">
    <name>Taganga</name>
    <desc>verified 2026-09-26: fishing village next to Santa Marta; closing leg back to Isla Margarita (order 0) is a flight per override.json and the page's 'Flight between Santa Marta &amp; Isla Margarita' polyline</desc>
  </wpt>
