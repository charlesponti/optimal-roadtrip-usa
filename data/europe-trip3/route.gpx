  <wpt lat="53.692840" lon="-6.449320">
    <name>Bru na Boinne</name>
    <desc>verified 2026-09-26: World Heritage site; drive point is the Bru na Boinne Visitor Centre (sole public access to the tombs)</desc>
  </wpt>
  <wpt lat="55.948611" lon="-3.200833">
