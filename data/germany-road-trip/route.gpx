  </wpt>
  <wpt lat="50.966342" lon="10.306342">
    <name>Wartburg, Auf der Wartburg, Eisenach</name>
    <desc>verified 2026-09-26: castle on a hilltop with restricted access road; drive point is Parkplatz Wartburg P1; legacy Google marker kept, 26 m from wikipedia:en:Wartburg</desc>
  </wpt>
  <wpt lat="51.836811" lon="10.784427">
    <name>Wernigerode, Deutschland</name>
    <desc>verified 2026-09-26: town; legacy Google marker kept, 210 m from wikipedia:en:Wernigerode</desc>
  </wpt>
  <wpt lat="53.075866" lon="8.807301">
    <name>Roland, Am Markt, Bremen</name>
    <desc>verified 2026-09-26: statue on the Marktplatz; router snaps to the nearest street; legacy Google marker kept, 4 m from wikipedia:en:Bremen_Roland</desc>
  </wpt>
  <wpt lat="53.859336" lon="8.687906">
    <name>Cuxhaven, Deutschland</name>
    <desc>verified 2026-09-26: town; legacy Google marker kept, 472 m from wikipedia:en:Cuxhaven</desc>
  </wpt>
  <wpt lat="53.545610" lon="9.954270">
    <name>Altona Fischmarkt, Große Elbstraße, Hamburg</name>
    <desc>verified 2026-09-26: Altona fish market; the 2015 Google marker sat 1.0 km west on Grosse Elbstrasse, so display moved to the market square (dewiki) and the legacy marker kept as drive point</desc>
  </wpt>
  <wpt lat="53.866258" lon="10.679627">
    <name>Museum Holstentor, Holstentorplatz, Lübeck</name>
    <desc>verified 2026-09-26: city gate; legacy Google marker kept, 8 m from wikipedia:en:Holsten_Gate</desc>
  </wpt>
  <wpt lat="54.573380" lon="13.660090">
    <name>Nationalpark-Zentrum Königsstuhl, Stubbenkammer, Sassnitz</name>
    <desc>verified 2026-09-26: visitor centre; the road to Konigsstuhl is closed to private cars, drive point is the Hagen car park (shuttle bus); legacy Google marker kept, 1 m from wikipedia:de:Nationalpark-Zentrum_Königsstuhl</desc>
  </wpt>
  <wpt lat="52.505022" lon="13.439695">
    <name>East Side Gallery, Mühlenstraße, Berlin</name>
